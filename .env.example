# Application
APP_NAME=ReckonFlow
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Local (native Postgres) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reckonflow

# --- Production (Neon) ---
# Neon gives postgres://... — change scheme to postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/neondb?ssl=require

# --- Redis: reuse an existing Upstash free DB (one DB is enough) ---
# Keys are namespaced with REDIS_KEY_PREFIX so they do not clash with your
# other app on the same instance
REDIS_URL=rediss://default:TOKEN@REGION.upstash.io:6379
REDIS_KEY_PREFIX=reckonflow:
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=86400

# Free-tier LLM (Groq) — leave empty to use the offline stub extractor
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

RECEIPT_STORAGE_DIR=var/receipts
